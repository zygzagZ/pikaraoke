msgid "%s added to the queue: %s"
msgstr "%s dodał(a) do kolejki: %s"

msgid "%s added to top of queue: %s"
msgstr "%s dodał(a) na początek kolejki: %s"

msgid "Added %s random tracks"
msgstr "Dodano %s losowych utworów"

msgid "Already downloaded: %s"
msgstr "Już pobrane: %s"

msgid "Clear queue"
msgstr "Wyczyść kolejkę"

msgid "Cleared the queue!"
msgstr "Kolejka wyczyszczona!"

msgid "Deleted from queue"
msgstr "Usunięto z kolejki"

msgid "Download queued (#%d): %s"
msgstr "Pobieranie w kolejce (#%d): %s"

msgid "Download starting: %s"
msgstr "Zaczynam pobieranie: %s"

msgid "Downloaded and queued: %s"
msgstr "Pobrano i dodano do kolejki: %s"

msgid "Downloaded: %s"
msgstr "Pobrano: %s"

msgid "Downloading audio: %s"
msgstr "Pobieram audio: %s"

msgid "Downloading video: %s"
msgstr "Pobieram wideo: %s"

msgid "Error deleting from queue"
msgstr "Błąd usuwania z kolejki"

msgid "Error downloading song: "
msgstr "Błąd pobierania utworu: "

msgid "Error moving down in queue"
msgstr "Błąd przesuwania w dół kolejki"

msgid "Error moving to bottom of queue"
msgstr "Błąd przesuwania na koniec kolejki"

msgid "Error moving to top of queue"
msgstr "Błąd przesuwania na początek kolejki"

msgid "Error moving up in queue"
msgstr "Błąd przesuwania w górę kolejki"

msgid "Error queueing song: "
