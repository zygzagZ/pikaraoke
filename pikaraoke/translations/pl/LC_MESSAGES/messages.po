msgid "Moved down in queue"
msgstr "Przesunięto w dół kolejki"

msgid "Moved to bottom of queue"
msgstr "Przesunięto na koniec kolejki"

msgid "Moved to top of queue"
msgstr "Przesunięto na początek kolejki"

msgid "Moved up in queue"
msgstr "Przesunięto w górę kolejki"

msgid "Pause: %s"
msgstr "Pauza: %s"

msgid "Ran out of songs!"
msgstr "Skończyły się piosenki!"

msgid "Resume: %s"
msgstr "Wznowiono: %s"

msgid "Separating vocals: %s"
msgstr "Oddzielam wokal: %s"

msgid "Skip: %s"
msgstr "Pominięto: %s"

msgid "Song added to the queue: %s"
msgstr "Dodano do kolejki: %s"

msgid "Song ended abnormally: %s"
msgstr "Utwór zakończył się nieprawidłowo: %s"

msgid "Song is already in the queue: %s"
msgstr "Utwór już jest w kolejce: %s"

msgid "Unauthorized"
msgstr "Brak uprawnień"

msgid "You don't have permission to add random songs"
msgstr "Nie masz uprawnień do dodawania losowych utworów"

msgid "You reached the limit of %s song(s) from an user in queue!"
msgstr "Osiągnięto limit %s utworów jednego użytkownika w kolejce!"
